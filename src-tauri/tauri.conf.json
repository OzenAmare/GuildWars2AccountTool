{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotnettauritest",
  "version": "0.1.0",
  "identifier": "com.oamare.dotnettauritest",
  "plugins":{
    "security_configuration":{
      "keyring_entry_name": "QUAGGIN_STRONGHOLD_PASSWORD",
      "keyring_username": "quaggin",
      "stronghold_snapshot_file": "quaggin_security_snapshot.snapshot",
      "stronghold_storage_file": "quaggin_security_storage.dat",    
      "Oauth2Configuration": {
        "oauth2_link": "https://gw2.me/oaut2/authorize?",
        "redirect_routing_endpoint": "/callback",
        "redirect_uri": "127.0.0.1:3000",
        "client_id": "b185490f-b41b-40bc-9b1d-a5d7eb22ac68",
        "response_type": "code",
        "scope": "identify",
       "prompt": "consent",
       "include_granted_scopes": "true"
      }
     }
   },
  "build": {
    "beforeDevCommand": "dotnet watch run --project src/Dotnettauritest.csproj",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "dotnet publish -c release src/Dotnettauritest.csproj -o dist",
    "frontendDist": "../dist/wwwroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "dotnettauritest",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
